{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NiuMaBooster",
  "version": "1.0.0",
  "identifier": "com.niuma.booster",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "牛马鼓励器",
        "width": 380,
        "height": 480,
        "minWidth": 340,
        "minHeight": 420,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "focus": false,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
